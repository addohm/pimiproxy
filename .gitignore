# Build-time copy of pimiproxy_common.py baked into the API image
pimiproxy-api/api/_bundled_common.py

# Static Docker Engine bundle (fetched on demand via 1_update-upstream.sh --docker)
docker-engine/

# Build inputs and outputs — never committed. Their Git LFS history outgrew
# GitHub's free 10 GiB quota, so release archives now ship as GitHub Release
# assets (scripts/4_publish-release.sh). A fresh clone regenerates them:
# 1_update-upstream.sh --all → 2_rebuild.sh → 3_build-releases.sh.
# releases/updates/ (the update_url bundles) is covered by releases/*.
bin/*
!bin/.gitkeep
docker-images/*
!docker-images/.gitkeep
releases/*
!releases/.gitkeep
